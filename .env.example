# Memories configuration — copy to .env and adjust:
#   cp .env.example .env

# ----------------------------------------------------------------------------
# Web server
# ----------------------------------------------------------------------------
# Keep WEB_HOST=0.0.0.0 in a container (a loopback bind makes the published
# port unreachable). WEB_PORT is the port INSIDE the container.
WEB_HOST=0.0.0.0
WEB_PORT=8090

# Public base URL used in password-reset links.
PUBLIC_URL=http://localhost:8090

# HMAC key for session tokens. REQUIRED in production — generate one with:
#   openssl rand -hex 32
# When empty an ephemeral secret is generated (sessions reset on restart).
WEB_SECRET=

# ----------------------------------------------------------------------------
# Bootstrap admin (created on first run only)
# ----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ----------------------------------------------------------------------------
# Storage — markdown memory tree, SQLite metadata and avatars
# ----------------------------------------------------------------------------
# Inside the container this is /data (set by the image); bare metal: ./data
MEMORIES_DATA_DIR=./data

# ----------------------------------------------------------------------------
# Password-reset e-mails (optional). When unset, the admin panel shows the
# reset link to copy instead of e-mailing it.
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=memories@example.com

# ----------------------------------------------------------------------------
# Infisical secret injection (optional, recommended in production)
# When the four INFISICAL_* values below are set, the container entrypoint
# authenticates with a Universal Auth machine identity and injects every
# secret of the project/environment into the process env — so WEB_SECRET,
# ADMIN_PASSWORD and SCRIBER_TOKEN can live in Infisical instead of this file.
# Leave empty to run with the plain environment.
# ----------------------------------------------------------------------------
INFISICAL_API_URL=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod

# ----------------------------------------------------------------------------
# External memory provider: Scriber (optional)
# Mounts a Scriber instance as a read/write virtual project (default name
# "scriber"). Create the token in Scriber: Settings -> API access
# (read & write scope for editing). See README "Compatible memory providers".
# ----------------------------------------------------------------------------
SCRIBER_URL=
SCRIBER_TOKEN=
SCRIBER_MOUNT=scriber
